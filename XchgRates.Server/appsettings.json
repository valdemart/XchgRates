{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SerilogSettings": {
    //see: https://github.com/serilog/serilog-extensions-logging-file?tab=readme-ov-file#appsettingsjson-configuration
    "PathFormat": "logs/log-{Date}.txt",
    "OutputTemplate": "{Timestamp} [{Level:u3}] {Message}{NewLine}{Exception}",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiConfigurations": [
    {
      "Id": "NBP",
      "DisplayName": "NBP",
      "Enabled": true,
      "Provider": "NBP",
      "BaseUrl": "https://api.nbp.pl"
    },
    {
      "Id": "NBP2",
      "DisplayName": "NBP jakiś inny",
      "Enabled": true,
      "Provider": "NBP",
      "BaseUrl": "https://api.nbp.pl"
    }
  ],
  "DateFormat": "yyyy-MM-dd",
  "SourceCurrencyOrdering": "CodeAscending",
  "TargetCurrencyOrdering": "NameAscending"
}
